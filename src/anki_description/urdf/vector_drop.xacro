<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="drop_sensor" params="link_name *origin">
    <link name="${link_name}"/>
    <joint name="${link_name}_joint" type="fixed">
        <parent link="base_link"/>
        <child link="${link_name}"/>
        <xacro:insert_block name="origin"/>
    </joint>
    <gazebo reference="${link_name}">
     <sensor type="ray" name="${link_name}_ranger">
        <pose>0 0 0 0 0 0</pose>
        <visualize>true</visualize>
        <update_rate>50</update_rate>
        <ray>
           <scan>
              <horizontal>
                 <samples>10</samples>
                 <resolution>1</resolution>
                 <min_angle>-0.14835</min_angle>
                 <max_angle>0.14835</max_angle>
              </horizontal>
              <vertical>
                 <samples>10</samples>
                 <resolution>1</resolution>
                 <min_angle>-0.14835</min_angle>
                 <max_angle>0.14835</max_angle>
              </vertical>
           </scan>
           <range>
              <min>0.001</min>
              <max>0.02</max>
              <resolution>0.02</resolution>
           </range>
        </ray>
        <topic>/vector/${link_name}</topic>
     </sensor>
     </gazebo>
  </xacro:macro>

  <xacro:drop_sensor link_name="drop_fl">
    <origin xyz="0.0351028 0.01 -0.0213898" rpy="0 1.57 0" />
  </xacro:drop_sensor>

  <xacro:drop_sensor link_name="drop_fr">
    <origin xyz="0.0351028 -0.01 -0.0213898" rpy="0 1.57 0" />
  </xacro:drop_sensor>

  <xacro:drop_sensor link_name="drop_rl">
    <origin xyz="-0.02 0.01 -0.0213898" rpy="0 1.57 0" />
  </xacro:drop_sensor>

  <xacro:drop_sensor link_name="drop_rr">
    <origin xyz="-0.02 -0.01 -0.0213898" rpy="0 1.57 0" />
  </xacro:drop_sensor>

</robot>
